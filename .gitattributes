# Normalize text to LF in the repo; Windows checkouts get native endings.
* text=auto
# cmd.exe misparses LF-only batch files: force CRLF on every checkout.
*.bat text eol=crlf
# Laser files: store byte-for-byte, never convert line endings.
*.ezd binary
*.cor binary
*.lbrn binary
*.lbrn2 -text
*.clb -text
*.dxf -text
